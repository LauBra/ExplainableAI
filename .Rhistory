import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import roc_auc_score
import matplotlib.pyplot as plt
import shap
url = "https://raw.githubusercontent.com/npradaschnor/Pima-Indians-Diabetes-Dataset/master/diabetes.csv"
pima = pd.read_csv(url)
pima.head()
X = pima.drop(columns=["Outcome"])
y = pima["Outcome"]
feature_names = X.columns.tolist()
X_train, X_test, y_train, y_test = train_test_split(
X, y, test_size=0.3, random_state=123, stratify=y
)
rf = RandomForestClassifier(
n_estimators=300,
max_depth=None,
random_state=123,
n_jobs=-1
)
rf.fit(X_train, y_train)
y_pred_proba = rf.predict_proba(X_test)[:, 1]
auc = roc_auc_score(y_test, y_pred_proba)
auc
importances = rf.feature_importances_
vip = pd.Series(importances, index=feature_names).sort_values(ascending=True)
plt.figure(figsize=(6, 4))
vip.plot(kind="barh")
plt.xlabel("Mean decrease in impurity")
plt.title("Random Forest Variable Importance (Pima Indians)")
plt.tight_layout()
plt.show()
# Create the SHAP explainer
explainer = shap.TreeExplainer(rf)
# Use a subset of training data for speed (optional)
X_train_sample = X_train.sample(400, random_state=123) if X_train.shape[0] > 400 else X_train
shap_values = explainer.shap_values(X_train_sample)
base_value = explainer.expected_value
base_value
shap.summary_plot(
shap_values[1],  # class 1 (diabetes) contributions
X_train_sample,
plot_type="bar",
show=True
)
shap.summary_plot(
shap_values[1],
X_train_sample,
show=True
)
# Pick one row from the test set
i = 0
x_i = X_test.iloc[[i]]  # keep as DataFrame
shap_values_i = explainer.shap_values(x_i)
x_i, shap_values_i[1]
shap.initjs()
shap.force_plot(
base_value[1],
shap_values_i[1],
x_i
)

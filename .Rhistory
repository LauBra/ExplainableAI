#| label: setup
#| include: true
set.seed(2025)
library(tidyverse)
library(tidymodels)
library(janitor)
library(broom)
theme_set(theme_bw())
RANDOM_STATE <- 2025
smhs <- readr::read_csv("SMHS_general.csv") %>%
clean_names()
glimpse(smhs)
#| label: setup
#| include: true
set.seed(2025)
library(tidyverse)
library(tidymodels)
library(janitor)
library(broom)
theme_set(theme_bw())
smhs <- smhs %>%
mutate(
latent_cluster = factor(latent_cluster),
sex            = factor(sex),
ethnicity      = factor(ethnicity),
smoking_status = factor(smoking_status),
shift_worker   = factor(shift_worker),
family_history_diabetes = factor(family_history_diabetes)
)
metabolic_vars <- c(
"bmi",
"fasting_glucose",
"fasting_insulin",
"triglycerides",
"hdl",
"crp",
"alt",
"metabolic_pressure",
"alcohol_units_week",
"deprivation_index",
"sleep_duration_hours",
"sleep_variability_hours",
"steps_per_day",
"sbp",
"dbp"
)
categorical_vars <- c(
"sex",
"ethnicity",
"smoking_status",
"shift_worker",
"family_history_diabetes"
)
cluster_summary_cont <- smhs %>%
group_by(latent_cluster) %>%
summarise(
n = n(),
across(all_of(metabolic_vars), ~ mean(.x, na.rm = TRUE), .names = "{.col}_mean")
)
cluster_summary_cont
smhs %>%
pivot_longer(cols = all_of(c("bmi", "fasting_glucose", "fasting_insulin",
"triglycerides", "hdl", "metabolic_pressure")),
names_to = "variable", values_to = "value") %>%
ggplot(aes(x = latent_cluster, y = value)) +
geom_boxplot() +
facet_wrap(~ variable, scales = "free_y") +
labs(x = "Latent cluster", y = NULL)
cat_tables <- lapply(categorical_vars, function(v) {
smhs %>%
count(latent_cluster, .data[[v]]) %>%
group_by(latent_cluster) %>%
mutate(prop = n / sum(n)) %>%
ungroup()
})
names(cat_tables) <- categorical_vars
cat_tables$ethnicity
distinguishing_vars <- map_dfr(metabolic_vars, function(var) {
df <- smhs %>%
select(latent_cluster, all_of(var)) %>%
drop_na()
fit <- aov(reformulate("latent_cluster", response = var), data = df)
anova_tab <- summary(fit)[[1]]
p_value <- anova_tab["latent_cluster", "Pr(>F)"]
ss_between <- anova_tab["latent_cluster", "Sum Sq"]
ss_total   <- sum(anova_tab[, "Sum Sq"], na.rm = TRUE)
eta_sq     <- ifelse(ss_total > 0, ss_between / ss_total, NA_real_)
tibble(variable = var, p_value = p_value, effect_size = eta_sq)
})
distinguishing_vars %>%
arrange(desc(effect_size)) %>%
slice_head(n = 10)
smhs_reg <- smhs %>%
filter(!is.na(metabolic_pressure))
set.seed(RANDOM_STATE)
data_split <- initial_split(smhs_reg, prop = 0.8)
train_data <- training(data_split)
test_data  <- testing(data_split)
baseline_recipe <- recipe(metabolic_pressure ~ fasting_glucose, data = train_data) %>%
step_impute_median(fasting_glucose)
baseline_spec <- linear_reg() %>% set_engine("lm")
baseline_wf <- workflow() %>%
add_model(baseline_spec) %>%
add_recipe(baseline_recipe)
baseline_fit <- baseline_wf %>% fit(data = train_data)
baseline_preds <- predict(baseline_fit, test_data) %>%
bind_cols(test_data %>% select(metabolic_pressure))
baseline_metrics <- metric_set(rmse, rsq)(
baseline_preds,
truth = metabolic_pressure,
estimate = .pred
)
baseline_metrics
parsimonious_vars <- c(
"bmi", "fasting_glucose", "fasting_insulin",
"triglycerides", "hdl", "crp", "alt",
"sbp", "sleep_duration_hours",
"deprivation_index", "steps_per_day"
)
parsimonious_vars <- parsimonious_vars[parsimonious_vars %in% names(train_data)]
physio_recipe <- recipe(metabolic_pressure ~ ., data = train_data) %>%
step_select(all_of(c("metabolic_pressure", parsimonious_vars))) %>%
step_impute_median(all_numeric_predictors()) %>%
step_normalize(all_numeric_predictors())
physio_spec <- linear_reg() %>% set_engine("lm")
physio_wf <- workflow() %>%
add_model(physio_spec) %>%
add_recipe(physio_recipe)
physio_fit <- physio_wf %>% fit(data = train_data)
physio_preds <- predict(physio_fit, test_data) %>%
bind_cols(test_data %>% select(metabolic_pressure))
physio_preds <- predict(physio_fit, test_data) %>%
bind_cols(test_data %>% dplyr::select(metabolic_pressure))
rf_recipe <- recipe(metabolic_pressure ~ ., data = train_data) %>%
step_rm(latent_cluster) %>%
step_impute_median(all_numeric_predictors()) %>%
step_impute_mode(all_nominal_predictors()) %>%
step_dummy(all_nominal_predictors()) %>%
step_normalize(all_numeric_predictors())
rf_spec <- rand_forest(
mtry = tune(),
trees = 500,
min_n = tune()
) %>%
set_engine("ranger") %>%
set_mode("regression")
rf_wf <- workflow() %>%
add_model(rf_spec) %>%
add_recipe(rf_recipe)
set.seed(RANDOM_STATE)
cv_folds <- vfold_cv(train_data, v = 5)
rf_grid <- grid_regular(
mtry(range = c(5, 20)),
min_n(),
levels = 4
)
rf_tuned <- tune_grid(
rf_wf,
resamples = cv_folds,
grid = rf_grid,
metrics = metric_set(rmse, rsq)
)
best_rf <- select_best(rf_tuned, metric = "rmse")
rf_final <- finalize_workflow(rf_wf, best_rf) %>%
fit(data = train_data)
rf_preds <- predict(rf_final, test_data) %>%
bind_cols(test_data %>% select(metabolic_pressure))
metric_set(rmse, rsq)(rf_preds,
truth = metabolic_pressure,
estimate = .pred)
library(reticulate)
